---
import { tagUrl } from '../lib/content';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags" aria-label="Tags">
      {tags.map((tag) => (
        <li>
          <a href={tagUrl(tag)}>{tag}</a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  a {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-3);
    text-decoration: none;
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  a:hover {
    color: var(--text);
    border-color: var(--text-3);
  }
</style>
