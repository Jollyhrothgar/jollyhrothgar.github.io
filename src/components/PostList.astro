---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import { formatDate, seriesUrl } from '../lib/content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  // For one series in reading order: show "Part N" in place of the series name
  numbered?: boolean;
}

const { posts, numbered = false } = Astro.props;
---

<ol class="posts">
  {
    posts.map((post, i) => (
      <li>
        <p class="meta">
          {numbered && <span>Part {i + 1} · </span>}
          <time datetime={post.data.date.toISOString().slice(0, 10)}>
            {formatDate(post.data.date)}
          </time>
          {!numbered && post.data.series && (
            <>
              {' · '}
              <a href={seriesUrl(post.data.series)} class="series">
                {post.data.series}
              </a>
            </>
          )}
        </p>
        <h2>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          {post.data.draft && <span class="draft">Draft</span>}
        </h2>
        <p>{post.data.description}</p>
        <TagList tags={post.data.tags} />
      </li>
    ))
  }
</ol>

<style>
  .posts {
    list-style: none;
    max-width: 720px;
  }

  li {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .meta {
    color: var(--text-3);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .series {
    color: var(--text-2);
    font-weight: 500;
    text-decoration: none;
  }

  .series:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  h2 {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0.25rem 0 0.5rem;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    opacity: 0.7;
  }

  p {
    color: var(--text-2);
    margin-bottom: 0.75rem;
  }

  .draft {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    vertical-align: middle;
    margin-left: 0.75rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--text-3);
    border-radius: 4px;
    color: var(--text-3);
  }
</style>
