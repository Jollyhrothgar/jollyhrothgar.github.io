---
// Example interactive element for MDX posts: random walkers drawn on a canvas. It animates only
// while on screen, and restarts on click. Copy this file as the starting point for a new sim.
interface Props {
  walkers?: number;
  height?: number;
}

const { walkers = 12, height = 280 } = Astro.props;
---

<figure class="sim">
  <random-walk data-walkers={walkers}>
    <canvas height={height} aria-label="Animated random walks. Click to restart."></canvas>
  </random-walk>
  <figcaption>{walkers} random walkers. Click to restart.</figcaption>
</figure>

<script>
  // A custom element, so each copy of the component on a page runs independently
  class RandomWalk extends HTMLElement {
    private canvas!: HTMLCanvasElement;
    private ctx!: CanvasRenderingContext2D;
    private points: { x: number; y: number }[] = [];
    private frame = 0;
    private running = false;

    connectedCallback() {
      this.canvas = this.querySelector('canvas')!;
      this.ctx = this.canvas.getContext('2d')!;
      this.reset();
      this.canvas.addEventListener('click', () => this.reset());

      // Animate only while visible, so off-screen sims cost nothing
      new IntersectionObserver(([entry]) => {
        this.running = entry.isIntersecting;
        if (this.running) this.frame = requestAnimationFrame(() => this.step());
        else cancelAnimationFrame(this.frame);
      }).observe(this.canvas);
    }

    private reset() {
      const ratio = window.devicePixelRatio || 1;
      const width = this.canvas.clientWidth;
      const height = Number(this.canvas.getAttribute('height'));
      this.canvas.width = width * ratio;
      this.canvas.height = height * ratio;
      this.canvas.style.height = `${height}px`;
      this.ctx.scale(ratio, ratio);
      const count = Number(this.dataset.walkers);
      this.points = Array.from({ length: count }, () => ({ x: width / 2, y: height / 2 }));
    }

    private step() {
      const { ctx } = this;
      const style = getComputedStyle(this);
      ctx.strokeStyle = style.color;
      ctx.globalAlpha = 0.5;
      ctx.lineWidth = 1;
      for (const p of this.points) {
        const angle = Math.random() * Math.PI * 2;
        const next = { x: p.x + Math.cos(angle) * 3, y: p.y + Math.sin(angle) * 3 };
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(next.x, next.y);
        ctx.stroke();
        Object.assign(p, next);
      }
      if (this.running) this.frame = requestAnimationFrame(() => this.step());
    }
  }

  customElements.define('random-walk', RandomWalk);
</script>

<style>
  .sim {
    margin: 2rem 0;
  }

  random-walk {
    display: block;
    color: var(--text);
  }

  canvas {
    display: block;
    width: 100%;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 8px;
    cursor: pointer;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-3);
  }
</style>
