---
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, getTags, slugify, type Group } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.some((name) => slugify(name) === tag.slug)),
    },
  }));
}

interface Props {
  tag: Group;
  posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;
---

<Base title={`${tag.name} · Blog · Mike Beaumier`} description={`Posts about ${tag.name}.`}>
  <header class="page-header">
    <p class="meta"><a href="/blog/">Blog</a></p>
    <h1>{tag.name}</h1>
    <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </header>

  <PostList posts={posts} />
</Base>

<style>
  .meta a {
    color: inherit;
    text-decoration: none;
  }

  .meta a:hover {
    color: var(--text);
  }
</style>
