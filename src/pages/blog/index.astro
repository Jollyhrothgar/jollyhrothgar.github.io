---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, getTags } from '../../lib/content';

const posts = await getPosts();
const tags = getTags(posts);
---

<Base title="Blog · Mike Beaumier" description="Writing by Mike Beaumier.">
  <header class="page-header">
    <h1>Blog</h1>
    {
      tags.length > 0 && (
        <p class="topics">
          Topics:{' '}
          {tags.map((tag, i) => (
            <>
              {i > 0 && ' · '}
              <a href={`/blog/tags/${tag.slug}/`}>{tag.name}</a>
            </>
          ))}
        </p>
      )
    }
  </header>

  {posts.length === 0 ? <p class="empty">Nothing here yet.</p> : <PostList posts={posts} />}
</Base>

<style>
  .topics {
    font-size: 1rem;
  }

  .topics a {
    color: var(--text);
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }

  .topics a:hover {
    text-decoration-color: currentColor;
  }

  .empty {
    color: var(--text-3);
  }
</style>
