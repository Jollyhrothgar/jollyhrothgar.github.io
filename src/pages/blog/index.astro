---
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../lib/content';

const posts = await getPosts();
---

<Base title="Blog · Mike Beaumier" description="Writing by Mike Beaumier.">
  <header class="page-header">
    <h1>Blog</h1>
  </header>

  {
    posts.length === 0 ? (
      <p class="empty">Nothing here yet.</p>
    ) : (
      <ol class="posts">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>
                {formatDate(post.data.date)}
              </time>
              <h2>
                {post.data.title}
                {post.data.draft && <span class="draft">Draft</span>}
              </h2>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</Base>

<style>
  .posts {
    list-style: none;
    max-width: 720px;
  }

  .posts li + li {
    margin-top: 1rem;
  }

  .posts a {
    display: block;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .posts a:hover {
    opacity: 0.7;
  }

  time {
    color: var(--text-3);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }

  h2 {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0.25rem 0 0.5rem;
  }

  p {
    color: var(--text-2);
  }

  .draft {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    vertical-align: middle;
    margin-left: 0.75rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--text-3);
    border-radius: 4px;
    color: var(--text-3);
  }

  .empty {
    color: var(--text-3);
  }
</style>
