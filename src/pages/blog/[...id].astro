---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import { formatDate, getPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, updated, draft, tags } = post.data;
const { Content } = await render(post);
---

<Base title={`${title} · Mike Beaumier`} description={description}>
  <article>
    <header class="page-header">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
        {updated && <span> · Updated {formatDate(updated)}</span>}
        {draft && <span> · Draft</span>}
      </p>
      <div class="tags"><TagList tags={tags} /></div>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <p class="back"><a href="/blog/" class="link">All posts</a></p>
</Base>

<style>
  .tags {
    margin-top: 1rem;
  }

  .back {
    margin-top: 4rem;
  }
</style>
