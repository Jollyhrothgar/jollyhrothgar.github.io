---
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, getSeries, getSeriesPosts, type Group } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getSeries(posts).map((series) => ({
    params: { series: series.slug },
    props: { series, posts: getSeriesPosts(posts, series.slug) },
  }));
}

interface Props {
  series: Group;
  posts: CollectionEntry<'blog'>[];
}

const { series, posts } = Astro.props;
---

<Base
  title={`${series.name} · Blog · Mike Beaumier`}
  description={`${series.name}: a series of ${posts.length} posts by Mike Beaumier.`}
>
  <header class="page-header">
    <p class="meta"><a href="/blog/">Blog</a> · Series</p>
    <h1>{series.name}</h1>
    <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'}, oldest first</p>
  </header>

  <PostList posts={posts} numbered />
</Base>

<style>
  .meta a {
    color: inherit;
    text-decoration: none;
  }

  .meta a:hover {
    color: var(--text);
  }
</style>
