---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
import { cv } from '../lib/cv';
---

<Base title="Mike Beaumier">
  <section class="intro">
    <div class="intro-text">
      <h1>Mike Beaumier</h1>
      <p class="lead">{cv.basics.headline} Banjo player. Nerd.</p>

      <p>
        I'm a data scientist and AI engineer with a decade of professional experience, from
        seed-stage startups and consulting and mentoring all the way up to Google scale.
      </p>
      <p>
        I specialize and thrive in environments where hard problems need to be scoped into
        concrete, validated, measured, and automated workflows. I've done that across a pretty
        big breadth of domains: particle physics, on-device automotive ML, cybersecurity, sales
        and marketing, and advertising technology.
      </p>
      <p>
        I love high-collaboration, high-velocity professional environments where teamwork,
        process introspection, and optimization matter just as much as quality results.
      </p>
      <p>
        <a href="/cv/" class="link">Read my CV</a> to learn about my work as a founding staff data
        scientist at Delphos Labs, a data scientist at Google, and a machine learning engineer at
        Mercedes-Benz R&D.
      </p>

      <Divider />

      <p>
        Outside of work, I'm a serial builder and creator, whether that's woodworking,
        pizza-making and cooking, or playing bluegrass with my band, <a
          href="https://www.thepassingfancies.com"
          class="link">The Passing Fancies</a>.
      </p>
      <p>
        I'm spending a lot of time these days thinking about how technology can enrich the
        California bluegrass scene. My big passion project here is solo-building <a
          href="https://bluegrassbook.com"
          class="link">Bluegrass Book</a>, a "missing link" app
        that turns the standard bluegrass repertoire into a searchable, discoverable songbook. It
        does in-browser editing of lyrics and chords, tablature editing and playback, and jam-list
        creation and sharing, all free (for now) and all on-device.
      </p>
    </div>
    <picture>
      <!-- On phones, a square crop of just the wizard and the banjo -->
      <source media="(max-width: 768px)" srcset="/Mike-square.jpg" />
      <img src="/Mike.JPG" alt="Mike in a wizard costume, playing the banjo" />
    </picture>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4rem;
    align-items: start;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .intro-text {
    max-width: 580px;
  }

  .intro-text p {
    color: var(--text-2);
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
  }

  .intro-text p:last-child {
    margin-bottom: 0;
  }

  .intro-text .lead {
    color: var(--text);
    font-size: 1.3rem;
    line-height: 1.45;
    margin-bottom: 2rem;
  }

  .intro img {
    width: 100%;
    aspect-ratio: 0.618;
    object-fit: cover;
    border-radius: 8px;
    filter: grayscale(20%);
  }

  @media (max-width: 768px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    /* Full width of the text column, so its edges line up with the text */
    .intro picture {
      order: -1;
    }

    .intro img {
      aspect-ratio: 4 / 3;
      object-position: center 30%;
    }
  }
</style>
