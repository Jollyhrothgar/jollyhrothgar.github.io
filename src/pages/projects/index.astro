---
import Base from '../../layouts/Base.astro';
import { getProjects, hasWriteUp } from '../../lib/content';

const projects = await getProjects();
---

<Base title="Projects · Mike Beaumier" description="Things Mike Beaumier has built.">
  <header class="page-header">
    <h1>Projects</h1>
    <p>Things I've built.</p>
  </header>

  <ul class="projects">
    {
      projects.map((project) => {
        const writeUp = hasWriteUp(project) ? `/projects/${project.id}/` : undefined;
        return (
          <li class="project">
            <h2>
              <a href={writeUp ?? project.data.url}>{project.data.title}</a>
            </h2>
            <p>{project.data.description}</p>
            <ul class="links">
              {writeUp && (
                <li>
                  <a href={writeUp}>Write-up</a>
                </li>
              )}
              <li>
                <a href={project.data.url}>Visit</a>
              </li>
              {project.data.repo && (
                <li>
                  <a href={project.data.repo}>Source</a>
                </li>
              )}
            </ul>
          </li>
        );
      })
    }
  </ul>
</Base>

<style>
  .projects {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 4rem;
  }

  .project {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }

  h2 {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    opacity: 0.7;
  }

  p {
    color: var(--text-2);
  }

  .links {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
    font-size: 0.95rem;
  }

  .links a {
    color: var(--text-3);
    font-weight: 500;
    text-decoration: none;
  }

  .links a:hover {
    color: var(--text);
  }

  @media (max-width: 768px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
