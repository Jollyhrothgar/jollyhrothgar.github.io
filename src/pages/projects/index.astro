---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { SECTIONS, getProjects } from '../../lib/content';

const projects = await getProjects();
const sections = SECTIONS.map((section) => ({
  ...section,
  projects: projects.filter((project) => project.data.section === section.id),
})).filter((section) => section.projects.length > 0);
---

<Base title="Projects · Mike Beaumier" description="Things Mike Beaumier has built.">
  <header class="page-header">
    <h1>Projects</h1>
    <p>Things I've built.</p>
  </header>

  {
    sections.map((section) => (
      <section aria-label={section.title ?? 'Featured'}>
        {section.title && <h2>{section.title}</h2>}
        <div class:list={['grid', { wide: section.wide }]}>
          {section.projects.map((project) => (
            <ProjectCard project={project} wide={section.wide} />
          ))}
        </div>
      </section>
    ))
  }
</Base>

<style>
  section + section {
    margin-top: 5rem;
  }

  h2 {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5rem 3rem;
  }

  .grid.wide {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }
  }
</style>
