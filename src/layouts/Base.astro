---
import '../styles/global.css';
import { cv } from '../lib/cv';

interface Props {
  title: string;
  description?: string;
}

const { title, description = cv.basics.headline } = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/cv/', label: 'CV' },
];
const current = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <nav class="site-nav" aria-label="Site">
        <a href="/" class="site-name">Mike Beaumier</a>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <ul>
          {
            cv.basics.links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </footer>
    </div>
  </body>
</html>
