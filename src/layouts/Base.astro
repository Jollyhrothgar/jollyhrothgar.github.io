---
import '../styles/global.css';
import { cv } from '../lib/cv';
import { getPosts, showConsulting } from '../lib/content';

interface Props {
  title: string;
  description?: string;
}

const { title, description = cv.basics.headline } = Astro.props;

// Blog shows up in the nav once there is at least one published post
const hasPosts = (await getPosts()).length > 0;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  hasPosts && { href: '/blog/', label: 'Blog' },
  showConsulting && { href: '/consulting/', label: 'Consulting' },
  { href: '/cv/', label: 'CV' },
].filter((item) => item !== false);

const current = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <nav class="site-nav" aria-label="Site">
        <a href="/" class="site-name">Mike Beaumier</a>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <ul>
          {
            cv.basics.links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </footer>
    </div>
  </body>
</html>
