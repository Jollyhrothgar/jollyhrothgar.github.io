---
import '../styles/global.css';
import { cv } from '../lib/cv';
import { getPosts } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  // The image shown when the page is shared. Defaults to the section's card.
  image?: string;
  // The image's size in pixels. Needed with `image`; the cards are 2400×1260.
  imageSize?: { width: number; height: number };
  // Set on blog posts
  article?: { published: Date; updated?: Date };
}

const { title, description = cv.basics.headline, image, imageSize, article } = Astro.props;

// Share cards, rendered by docs/og/render.sh: one per section, labelled above the name, and
// the unlabelled site card for everything else
const sectionCards = [
  { path: '/cv/', src: '/og/cv.png', label: 'Work History' },
  { path: '/blog/', src: '/og/blog.png', label: 'Writing' },
  { path: '/projects/', src: '/og/projects.png', label: 'Project Portfolio' },
  { path: '/consulting/', src: '/og/consulting.png', label: 'Consulting' },
];
const tagline = 'Mike Beaumier: AI Engineering and Data Science with a side of Bluegrass';
const card = sectionCards.find((c) => Astro.url.pathname.startsWith(c.path));
const share = image
  ? { src: image, ...imageSize, alt: title }
  : {
      src: card?.src ?? '/og.png',
      width: 2400,
      height: 1260,
      alt: card ? `${card.label} · ${tagline}` : tagline,
    };
const canonical = new URL(Astro.url.pathname, Astro.site);

// Blog shows up in the nav once there is at least one published post
const hasPosts = (await getPosts()).length > 0;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  hasPosts && { href: '/blog/', label: 'Blog' },
  { href: '/consulting/', label: 'Consulting' },
  { href: '/cv/', label: 'CV' },
].filter((item) => item !== false);

const current = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      // Google Analytics, only in the built site so local previews don't count as visits
      import.meta.env.PROD && (
        <>
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-EK7YRGGWM7" />
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', 'G-EK7YRGGWM7');
          </script>
        </>
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Link previews on LinkedIn, Slack, Bluesky and so on -->
    <meta property="og:site_name" content="Mike Beaumier" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(share.src, Astro.site)} />
    {share.width && <meta property="og:image:width" content={String(share.width)} />}
    {share.height && <meta property="og:image:height" content={String(share.height)} />}
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      article && (
        <meta property="article:published_time" content={article.published.toISOString()} />
      )
    }
    {
      article?.updated && (
        <meta property="article:modified_time" content={article.updated.toISOString()} />
      )
    }

    <link rel="alternate" type="application/rss+xml" title="Mike Beaumier" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <nav class="site-nav" aria-label="Site">
        <a href="/" class="site-name">Mike Beaumier</a>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <ul>
          {
            cv.basics.links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </footer>
    </div>
  </body>
</html>
