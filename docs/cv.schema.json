{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikebeaumier.com/cv.schema.json",
  "title": "mikebeaumier.com public CV",
  "description": "Format of src/data/cv.json. See docs/cv-json.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "basics", "experience", "education", "publications", "skills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit"],
      "properties": {
        "repo": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "headline", "links"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "headline": { "$ref": "#/$defs/text" },
        "location": { "$ref": "#/$defs/text" },
        "email": { "type": "string", "format": "email" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "$ref": "#/$defs/text" },
              "url": { "$ref": "#/$defs/url" }
            }
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "organization", "roles"],
        "properties": {
          "kind": { "enum": ["work", "research", "fellowship", "volunteer"] },
          "organization": { "$ref": "#/$defs/text" },
          "location": { "$ref": "#/$defs/text" },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "start", "end", "highlights", "projects"],
              "properties": {
                "title": { "$ref": "#/$defs/text" },
                "start": { "$ref": "#/$defs/date" },
                "end": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
                "summary": { "type": "string" },
                "highlights": { "$ref": "#/$defs/textList" },
                "projects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "highlights"],
                    "properties": {
                      "name": { "$ref": "#/$defs/text" },
                      "year": { "type": "string", "pattern": "^\\d{4}(-\\d{4})?$" },
                      "role": { "$ref": "#/$defs/text" },
                      "summary": { "type": "string" },
                      "highlights": { "$ref": "#/$defs/textList" },
                      "technologies": { "$ref": "#/$defs/textList" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["degree", "institution", "start", "end"],
        "properties": {
          "degree": { "$ref": "#/$defs/text" },
          "institution": { "$ref": "#/$defs/text" },
          "start": { "$ref": "#/$defs/date" },
          "end": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
          "note": { "type": "string" }
        }
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "year", "type", "selected"],
        "properties": {
          "title": { "$ref": "#/$defs/text" },
          "venue": { "$ref": "#/$defs/text" },
          "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
          "type": { "enum": ["article", "instrumentation", "proceedings", "talk", "thesis"] },
          "url": { "$ref": "#/$defs/url" },
          "collaboration": { "$ref": "#/$defs/text" },
          "authorCount": { "type": "integer", "minimum": 1 },
          "selected": { "type": "boolean" },
          "contribution": { "$ref": "#/$defs/text" }
        },
        "if": { "properties": { "selected": { "const": true } } },
        "then": { "required": ["contribution"] }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "items"],
        "properties": {
          "group": { "$ref": "#/$defs/text" },
          "items": { "$ref": "#/$defs/textList", "minItems": 1 }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "^[^\\n<>]*$" },
    "textList": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "date": { "type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$" },
    "url": { "type": "string", "pattern": "^https://" }
  }
}
